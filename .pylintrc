# Pylint configuration for edge-kb-ai.
#
# Genuine defects (unused imports/vars, import hygiene, whitespace, refactors) are
# fixed in code. The disables below are NOT bug suppression — each is either an
# intentional pattern in this repo, a framework/dynamic-analysis false positive,
# or a design-metric threshold (a style opinion, not a defect). Kept small and
# documented so real errors (E-category, unused code, etc.) still surface.
#
#   Run:  venv\Scripts\python.exe -m pylint api core models services tests main.py conftest.py

[MAIN]
# Tests exercise private module state (_agent, _status) by design.
py-version = 3.13

[MESSAGES CONTROL]
disable =
    # --- Repo style: docstrings are deliberate, not required on every symbol ---
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,

    # --- Intentional patterns in this codebase ---
    import-outside-toplevel,        # lazy imports inside functions are mandated (CLAUDE.md)
    broad-exception-caught,         # deliberate resilience (agent/MCP fall back, never crash)
    global-statement,              # module-level singletons (_agent, documents, ids, retriever)
    global-variable-not-assigned,  # same module-state pattern

    # --- Framework / dynamic-analysis false positives ---
    no-member,                     # pylint can't resolve lazily-imported service-module globals
    redefined-builtin,             # `filter=` param matches the vector-store / Chroma API
    redefined-outer-name,          # pytest fixture-argument idiom
    protected-access,              # tests inspect _agent/_status/_path intentionally
    unused-argument,               # FastAPI route / Protocol / fake signatures
    consider-using-with,           # setUp/tearDown temp dirs outlive a `with` block
    use-dict-literal,              # dict(kw=...) is idiomatic here and kept

    # --- Design-metric thresholds (style opinions, not defects) ---
    too-few-public-methods,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-instance-attributes,
    too-many-branches,
    too-many-return-statements,

[FORMAT]
max-line-length = 120

[BASIC]
# Module-level mutable singletons that pylint mistakes for constants.
good-names = _agent, template, i, j, k, ex, _
