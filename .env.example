# ------------------------------------------------------------------------------
# Model mode
# ------------------------------------------------------------------------------
# Use "local" for Ollama, or "hosted" for OpenAI/Groq-compatible APIs.
LLM_MODE=local

# ------------------------------------------------------------------------------
# Local model (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_LLM_MODEL=gemma4

# ------------------------------------------------------------------------------
# Hosted model
# ------------------------------------------------------------------------------
# Used only when LLM_MODE=hosted.
HOSTED_LLM_PROVIDER=openai
HOSTED_LLM_MODEL=gpt-4o-mini
HOSTED_LLM_API_KEY=
HOSTED_LLM_BASE_URL=
HOSTED_LLM_TEMPERATURE=1
HOSTED_LLM_TOP_P=1
HOSTED_LLM_MAX_TOKENS=2048
GROQ_REASONING_EFFORT=medium

# Optional provider-specific fallback keys.
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------------------
# Use "local" for Ollama embeddings, "custom" for deterministic hash embeddings,
# or "hosted" for hosted embeddings.
EMBEDDING_MODE=local
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSIONS=384
HOSTED_EMBEDDING_PROVIDER=openai
HOSTED_EMBEDDING_MODEL=text-embedding-3-small
HOSTED_EMBEDDING_API_KEY=
HOSTED_EMBEDDING_BASE_URL=

# ------------------------------------------------------------------------------
# Chunking model
# ------------------------------------------------------------------------------
# Use "local" for Ollama chunking, or "hosted" for a hosted chunking model.
# If unset, chunking follows LLM_MODE.
CHUNKING_MODE=local
OLLAMA_CHUNKING_MODEL=gemma4
HOSTED_CHUNKING_PROVIDER=openai
HOSTED_CHUNKING_MODEL=gpt-4o-mini
HOSTED_CHUNKING_API_KEY=
HOSTED_CHUNKING_BASE_URL=
HOSTED_CHUNKING_TEMPERATURE=1
HOSTED_CHUNKING_TOP_P=1
HOSTED_CHUNKING_MAX_TOKENS=2048
# Local mode: split PDF/PPT docs longer than this many chars (0 = no split).
LOCAL_CHUNK_SIZE=1500

# ------------------------------------------------------------------------------
# Retrieval and chat history
# ------------------------------------------------------------------------------
RETRIEVER_K=5
RETRIEVER_K_PER_SOURCE=3
RETRIEVER_MAX_FILE_CHARS=12000
MAX_CHAT_HISTORY_MESSAGES=12
MAX_CHAT_HISTORY_CONTENT_CHARS=2000

# ------------------------------------------------------------------------------
# Jira / MCP (agentic chat)
# ------------------------------------------------------------------------------
# The chat is agentic: the LLM decides which tools to call. It can search the
# knowledge base and, when Jira is enabled, query Jira (read-only) via an MCP
# server. Requires: pip install langchain-mcp-adapters mcp-atlassian
# NOTE: agentic behaviour needs a tool-calling LLM (hosted OpenAI/Groq, or a
# tool-capable Ollama model such as llama3.1 / qwen2.5). The default gemma4
# cannot tool-call, so the app transparently falls back to the classic RAG chain.
# Check GET /ai/agent-status to see whether the agent and Jira tools loaded.
AGENT_ENABLED=true

JIRA_ENABLED=false
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
JIRA_READ_ONLY=true
# Optional comma-separated allow-list of MCP tools (empty = all read tools).
JIRA_ENABLED_TOOLS=
# Transport: "stdio" spawns the mcp-atlassian process; "streamable_http"
# connects to an already-running server at JIRA_MCP_URL.
JIRA_MCP_TRANSPORT=stdio
JIRA_MCP_COMMAND=mcp-atlassian
JIRA_MCP_URL=

# ------------------------------------------------------------------------------
# Vector store backend
# ------------------------------------------------------------------------------
# Use "chroma" (default) or "hana" for SAP HANA Cloud Vector Engine.
VECTOR_DB_BACKEND=chroma

# ChromaDB settings
# CHROMA_MODE: "local" for persist directory, "http" for client-server mode.
CHROMA_MODE=local
# The following are only used when CHROMA_MODE=http:
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_HEADERS={"Authorization": "Bearer token"}

# SAP HANA DB settings (only used when VECTOR_DB_BACKEND=hana)
# HANA_DB_ADDRESS=your-hana-host.hanacloud.ondemand.com
# HANA_DB_PORT=443
# HANA_DB_USER=your-user
# HANA_DB_PASSWORD=your-password
# HANA_DB_TABLE_NAME=LANGCHAIN_VECTORS

# ------------------------------------------------------------------------------
# File storage
# ------------------------------------------------------------------------------
FILE_STORAGE_BACKEND=local
DATA_DIR=data

AWS_S3_BUCKET=your-bucket-name
AWS_S3_PREFIX=rag-files
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_CACHE_DIR=.storage_cache
